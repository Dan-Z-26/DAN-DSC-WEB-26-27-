---
// TRIAL loader — experimental variant for comparing against IntroLoader.astro.
// Marvel-Studios-style sequential reveal: big </> symbol draws in first
// (equal-height strokes, wide spacing), then "DSC" appears one letter at a
// time (big, spaced out), then it crossfades to the small, equal-height full
// wordmark. Slow and deliberate on purpose — no simultaneous elements.
// Not mounted by default. Enable with `LOADER_VARIANT=trial` (see package.json
// scripts: `dev:loader-trial`). Safe to edit freely; the original is untouched.
---
<div id="intro-loader-trial" class="intro-loader-trial">
  <div class="trial-stage">
    <svg class="trial-symbol" viewBox="0 0 500 260" aria-hidden="true">
      <path class="bracket-left" d="M 140 50 L 20 130 L 140 210"
            fill="none" stroke="#2CA6A4" stroke-width="24"
            stroke-linecap="square" stroke-linejoin="miter"/>
      <path class="slash" d="M 210 210 L 270 50"
            fill="none" stroke="#2CA6A4" stroke-width="24"
            stroke-linecap="square"/>
      <path class="bracket-right" d="M 350 50 L 470 130 L 350 210"
            fill="none" stroke="#2CA6A4" stroke-width="24"
            stroke-linecap="square" stroke-linejoin="miter"/>
    </svg>

    <div class="trial-wordmark-wrap">
      <h1 class="trial-dsc">
        {['D', 'S', 'C'].map((ch) => (
          <span class="trial-dsc-letter">{ch}</span>
        ))}
      </h1>

      <h1 class="trial-fullname" aria-label="Developer Students Club">
        {"DEVELOPER STUDENTS CLUB".split(' ').map((word, wi) => (
          <>
            {wi > 0 && ' '}
            <span class="trial-word">
              {word.split('').map((ch) => (
                <span class="trial-letter">{ch}</span>
              ))}
            </span>
          </>
        ))}
      </h1>
    </div>
  </div>
</div>

<style>
  .intro-loader-trial {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at center, #10201f 0%, #05080a 70%);
    overflow: hidden;
  }

  .trial-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-inline: 1.5rem;
  }

  /* Beat 1: big </> symbol, equal-height strokes, wide spacing, drawn in */
  .trial-symbol {
    width: clamp(280px, 46vw, 560px);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0 22px rgba(44, 166, 164, 0.5));
    will-change: transform, opacity;
  }

  .trial-symbol path {
    will-change: stroke-dashoffset;
  }

  /* Beats 2 & 3 share one centered anchor point via CSS grid stacking */
  .trial-wordmark-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: min(94vw, 1000px);
  }

  .trial-dsc,
  .trial-fullname {
    grid-area: 1 / 1;
    margin: 0;
    text-align: center;
    font-family: 'Arial Narrow', Arial, sans-serif;
    font-weight: 800;
    color: #F5F5F5;
    will-change: transform, opacity;
  }

  /* Beat 2: DSC — big, generously spaced, one letter at a time */
  .trial-dsc {
    display: inline-flex;
    justify-content: center;
    align-items: baseline;
    gap: clamp(1.25rem, 4.5vw, 2.75rem);
    font-size: clamp(3rem, 10vw, 5.5rem);
  }

  .trial-dsc-letter {
    display: inline-block;
    opacity: 0;
    transform: translateX(28px);
  }

  /* Beat 3: full wordmark — small, equal height, same reveal style as DSC */
  .trial-fullname {
    font-size: clamp(1rem, 3vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: 4px;
  }

  .trial-word {
    display: inline-block;
    white-space: nowrap;
  }

  .trial-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    .trial-dsc-letter,
    .trial-letter {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { createTimeline, svg, stagger, utils } from 'animejs';

  const loader = document.getElementById('intro-loader-trial');
  if (loader) {
    document.body.style.overflow = 'hidden';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const stage = loader.querySelector('.trial-stage');
    const dsc = loader.querySelector('.trial-dsc');
    const dscLetters = loader.querySelectorAll('.trial-dsc-letter');
    const fullLetters = loader.querySelectorAll('.trial-letter');

    const pageContent = document.querySelectorAll('body > *:not(#intro-loader-trial)');
    utils.set(pageContent, { opacity: 0 });

    let minAnimMs = 6800;

    if (reduceMotion) {
      utils.set(dsc, { opacity: 0 });
      minAnimMs = 0;
    } else {
      const [bracketLeft, slash, bracketRight] = svg.createDrawable('.trial-symbol path');

      const tl = createTimeline({ defaults: { ease: 'outQuint' } });

      // Beat 1: symbol draws in slowly, left bracket -> slash -> right bracket
      tl.add(bracketLeft, { draw: '0 1', duration: 1000 })
        .add(slash, { draw: '0 1', duration: 1000 }, '-=850')
        .add(bracketRight, { draw: '0 1', duration: 1000 }, '-=850')
        // Beat 2: pause, then D, S, C slide in sideways one at a time, slowly
        .add(dscLetters, {
          opacity: [0, 1],
          translateX: [28, 0],
          duration: 700,
          delay: stagger(450),
          ease: 'outQuint',
        }, '+=500')
        // Beat 3: hold DSC, then crossfade to the small full wordmark, same
        // letter-by-letter reveal style, anchored at the same center point
        .add(dsc, { opacity: [1, 0], scale: [1, 1.05], duration: 700, ease: 'inOutQuad' }, '+=900')
        .add(fullLetters, {
          opacity: [0, 1],
          translateY: [12, 0],
          duration: 650,
          delay: stagger(45),
          ease: 'outQuint',
        }, '-=500');
    }

    const hideLoader = () => {
      if (loader.dataset.hidden) return;
      loader.dataset.hidden = 'true';
      document.body.style.overflow = '';

      createTimeline({ onComplete: () => loader.remove() })
        .add(stage, { scale: [1, 1.05], opacity: [1, 0], duration: 900, ease: 'outQuint' })
        .add(pageContent, { opacity: [0, 1], duration: 900, ease: 'outQuint' }, '-=600');
    };

    let windowLoaded = false;
    let minAnimTimeElapsed = reduceMotion;

    const tryHide = () => {
      if (windowLoaded && minAnimTimeElapsed) hideLoader();
    };

    if (document.readyState === 'complete') {
      windowLoaded = true;
    } else {
      window.addEventListener('load', () => {
        windowLoaded = true;
        tryHide();
      });
    }

    if (minAnimMs > 0) {
      setTimeout(() => {
        minAnimTimeElapsed = true;
        tryHide();
      }, minAnimMs);
    }

    // Safety timeout: never block the page longer than ~8.5s
    setTimeout(hideLoader, 8500);

    tryHide();
  }
</script>
