---
// Embers that ignite as the fire front passes them. `d` is the delay as a
// fraction of the sweep, matched to x so each one lights when the front
// arrives; dx/dy are the drift. Fixed (not random) so the look is reproducible.
const EMBERS = [
  { x: 6,  y: 82, s: 4, dx: 26,  dy: -150, d: 0.04 },
  { x: 11, y: 63, s: 3, dx: 40,  dy: -120, d: 0.08 },
  { x: 17, y: 88, s: 5, dx: 18,  dy: -190, d: 0.13 },
  { x: 23, y: 70, s: 3, dx: 46,  dy: -110, d: 0.18 },
  { x: 28, y: 55, s: 4, dx: 30,  dy: -165, d: 0.22 },
  { x: 34, y: 84, s: 3, dx: 52,  dy: -130, d: 0.27 },
  { x: 39, y: 66, s: 5, dx: 22,  dy: -200, d: 0.31 },
  { x: 45, y: 78, s: 3, dx: 38,  dy: -125, d: 0.36 },
  { x: 50, y: 52, s: 4, dx: 28,  dy: -170, d: 0.40 },
  { x: 56, y: 74, s: 3, dx: 48,  dy: -115, d: 0.45 },
  { x: 61, y: 60, s: 5, dx: 20,  dy: -185, d: 0.49 },
  { x: 67, y: 86, s: 3, dx: 44,  dy: -140, d: 0.54 },
  { x: 72, y: 48, s: 4, dx: 32,  dy: -160, d: 0.58 },
  { x: 78, y: 72, s: 3, dx: 50,  dy: -120, d: 0.63 },
  { x: 83, y: 40, s: 4, dx: 24,  dy: -175, d: 0.67 },
  { x: 88, y: 64, s: 3, dx: 42,  dy: -130, d: 0.72 },
  { x: 93, y: 36, s: 5, dx: 30,  dy: -195, d: 0.76 },
  { x: 97, y: 58, s: 3, dx: 36,  dy: -145, d: 0.81 },
];

// CINEMATIC loader — "Lava Horizon".
//
// The volcanic ridge from the hero rises out of the bottom of the frame as a
// black silhouette. The </> mark takes the centre, "DSC" settles beneath it,
// then fire spreads along the ridge left to right — and as it travels, DSC
// crossfades into the full "DEVELOPER STUDENTS CLUB / SRM IST RAMAPURAM"
// lockup. The frame holds on the lit ridge, then the type clears.
//
// Size hierarchy is deliberate and strictly descending:
//   </> mark  >  DSC  >  DEVELOPER STUDENTS CLUB  >  SRM IST RAMAPURAM
//
// The lit ridge layer ends at translate(0) with the same cover+center sizing as
// Hero's own background layer, so it IS the hero's resting frame and the handoff
// is a non-event. The loader also holds and releases the hero's Ken Burns and
// headline entrance via WAAPI so the camera move continues through the handoff.
// Hero.tsx and global.css are never modified.
//
// Not mounted by default. Enable with `LOADER_VARIANT=cinematic`
// (see package.json: `dev:loader-cinematic`).
---
<!-- Procedural fire. feTurbulence generates a noise field once (its attributes
     never change, so the result is cached); only feDisplacementMap's `scale`
     animates, which is comparatively cheap and makes the flame writhe instead
     of sliding across as a rigid shape. This is what turns the gradient into
     actual flame tongues rather than a coloured band. -->
<svg class="lh-defs" aria-hidden="true" focusable="false">
  <filter id="lhFireFx" x="-35%" y="-25%" width="170%" height="150%"
          color-interpolation-filters="sRGB">
    <!-- X frequency must be high enough to actually break the regular tongue
         banding apart — too low and the stripes survive as a picket fence.
         Y stays higher still so the licks tear upward. -->
    <feTurbulence type="fractalNoise" baseFrequency="0.032 0.075"
                  numOctaves="4" seed="11" result="noise"/>
    <feDisplacementMap in="SourceGraphic" in2="noise"
                       xChannelSelector="R" yChannelSelector="G" scale="34">
      <animate attributeName="scale" values="26;54;32;60;28"
               dur="0.7s" repeatCount="indefinite"/>
    </feDisplacementMap>
  </filter>
</svg>

<div id="intro-loader-cinematic" class="lh" aria-hidden="true">
  <!-- The ridge. Rises as one unit, lands at translate(0) = the hero's frame. -->
  <div class="lh-ridge">
    <div class="lh-lit"></div>
    <!-- A blazing-hot copy of the same terrain, masked to a narrow band that
         rides the burn edge. This is what actually sells the fire: the ridge's
         real lava veins flare white-hot as the front reaches them and cool back
         behind it, instead of a synthetic flame shape sliding over the top. -->
    <div class="lh-hot"></div>
    <!-- .lh-front is positioned/animated by anime; the flicker lives on the
         child so a CSS opacity animation can't fight anime's inline opacity. -->
    <div class="lh-front"><div class="lh-flame"></div></div>

    <!-- Sparks thrown off as the front passes. Pure CSS animation on a delay
         matched to each ember's x, so no per-frame JS. -->
    <div class="lh-embers">
      {EMBERS.map((e) => (
        <span
          class="lh-ember"
          style={`left:${e.x}%;top:${e.y}%;--s:${e.s}px;--dx:${e.dx}px;--dy:${e.dy}px;--d:${e.d}`}
        />
      ))}
    </div>
  </div>

  <!-- Molten heat rising off the ground. Fades out before the handoff so it
       can't disturb the pixel match with the hero. -->
  <div class="lh-heat"></div>

  <div class="lh-type">
    <!-- Geometry traced from Grey.png, then cleaned up for symmetry:
         - Both brackets are now EXACT mirrors of each other (159/213.5/268),
           not the ~1-unit-off values the raw trace produced.
         - Both gaps (bracket-to-slash) are equalized to 78.5 units — the
           previous +25/-25 outward shift preserved the traced asymmetry
           instead of fixing it (83 vs 74).
         - The slash is re-centered on the brackets' vertical midline (213.5)
           instead of sitting 8.5 units high, so it overshoots the bracket
           arms equally top and bottom (56 each way) rather than
           asymmetrically (64 top / 47.5 bottom). Its height (221, ~2.02x the
           bracket span) and stroke-width (40) are unchanged from the source. -->
    <svg class="lh-mark" viewBox="160 60 550 300" aria-hidden="true">
      <defs>
        <linearGradient id="lhMarkGradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#cdcdcd"/>
          <stop offset="100%" stop-color="#616161"/>
        </linearGradient>
        <!-- Grey.png's slash has genuinely HORIZONTAL top/bottom cuts (traced
             corners (504,94)/(464,95) are ~1px apart in y) — a flat-cut
             parallelogram, not the tilted cap stroke-linecap produces on a
             diagonal line. So the path below is drawn well past both ends (66
             to 361, vs. the visible 103 to 324) and this rect clips it back to
             an exact horizontal top and bottom. -->
        <clipPath id="lhSlashClip" clipPathUnits="userSpaceOnUse">
          <rect x="350" y="94" width="180" height="240"/>
        </clipPath>
      </defs>
      <path d="M 314.5 159 L 210.5 213.5 L 314.5 268" fill="none" stroke="url(#lhMarkGradient)"
            stroke-width="40" stroke-linecap="square" stroke-linejoin="miter"/>
      <path d="M 499.2 66 L 377.8 361" fill="none" stroke="url(#lhMarkGradient)"
            stroke-width="40" stroke-linecap="butt" clip-path="url(#lhSlashClip)"/>
      <path d="M 562.5 159 L 666.5 213.5 L 563 268" fill="none" stroke="url(#lhMarkGradient)"
            stroke-width="40" stroke-linecap="square" stroke-linejoin="miter"/>
    </svg>

    <!-- DSC and the full lockup are grid-stacked so they share one centre
         anchor and can crossfade in place without shifting. -->
    <div class="lh-stack">
      <div class="lh-dsc">
        <span class="lh-dsc-l">D</span>
        <span class="lh-dsc-l">S</span>
        <span class="lh-dsc-l">C</span>
      </div>

      <div class="lh-full">
        <h1 class="lh-word" aria-label="Developer Students Club">
          {"DEVELOPER STUDENTS CLUB".split(' ').map((w, wi) => (
            <>
              {wi > 0 && ' '}
              <span class="lh-nb">{w.split('').map((ch) => <span class="lh-l">{ch}</span>)}</span>
            </>
          ))}
        </h1>
        <p class="lh-sub" aria-label="SRM IST Ramapuram">
          {"SRM IST RAMAPURAM".split(' ').map((w, wi) => (
            <>
              {wi > 0 && ' '}
              <span class="lh-nb">{w.split('').map((ch) => <span class="lh-l">{ch}</span>)}</span>
            </>
          ))}
        </p>
      </div>
    </div>
  </div>
</div>

<noscript><style>#intro-loader-cinematic { display: none !important; }</style></noscript>

<!-- Hero-facing rules. Driven by <body> classes rather than inline styles,
     because <body> is not React-owned: writing inline styles onto Hero's nodes
     before hydration causes a React hydration mismatch it refuses to patch up.
     Astro also ships a page's component styles regardless of which conditional
     branch renders, so EVERY selector here is gated on a `body.ilc-*` class that
     only this component's script adds — that keeps the block provably inert for
     the other two loader variants. -->
<style is:global>
  body.ilc-active .dsc-marquee-container,
  body.ilc-active .home-nav-header {
    transition: opacity 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  body.ilc-running .dsc-marquee-container,
  body.ilc-running .home-nav-header {
    opacity: 0;
  }

  /* Hero.tsx renders the cursor-spotlight layer with `mask-image: none` until the
     first mousemove — and `none` means *unmasked*, so the mossy hero_bg2 sits
     fully opaque over the lava ridge. Held down so the ignition reveals the
     ridge; released once there's a real mask to show. */
  body.ilc-active #home div[style*="hero_bg2"] {
    transition: opacity 300ms ease;
  }

  body.ilc-reveal-hold #home div[style*="hero_bg2"] {
    opacity: 0;
  }
</style>

<style>
  .lh {
    position: fixed;
    inset: 0;
    z-index: 9999;
    overflow: hidden;
    background: #000;
    touch-action: none;
    overscroll-behavior: contain;
    /* Failsafe: this loader covers the live page, so if the script never runs
       the page would stay hidden. Only ever fires when JS is dead. */
    animation: lhFailsafe 0s linear 8s forwards;
  }

  @keyframes lhFailsafe {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  /* ---- the ridge ---------------------------------------------------------
     Both copies use the hero's exact cover+center sizing. At translate(0) the
     lit copy is pixel-identical to Hero's own background layer. */
  .lh-ridge {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .lh-lit,
  .lh-hot,
  .lh-front {
    position: absolute;
    inset: 0;
  }

  /* Static filter, never animated. The mask (rebuilt per frame) is what moves. */
  .lh-hot {
    background-image: url('/creative-ai/hero_bg1.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: brightness(3.1) saturate(1.8) contrast(1.1);
    -webkit-mask-image: linear-gradient(96deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(96deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%);
    will-change: mask-image;
  }

  /* The ONLY terrain layer. There is deliberately no dimmed copy underneath:
     the mountains must be completely invisible until the fire finds them, so
     the frame starts as pure black and the sweep is what brings them into
     existence. Starts fully masked out; the script rewrites the mask each
     frame with a soft leading edge (see the sweep tween). */
  .lh-lit {
    background-image: url('/creative-ai/hero_bg1.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    -webkit-mask-image: linear-gradient(96deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(96deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%);
    will-change: mask-image;
  }

  /* The travelling ignition front. Its bright end must land on the clip-path
     edge or the wipe reads as a hard vertical line — see the script for how the
     travel distance is matched to the sweep. */
  .lh-front {
    left: -26vw;
    width: 26vw;
    right: auto;
    opacity: 0;
    pointer-events: none;
    /* Fire spreads along the ground, not through empty sky — without this the
       front reads as a lit curtain crossing the black upper half of the frame. */
    -webkit-mask-image: linear-gradient(to top,
      rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.92) 20%,
      rgba(0, 0, 0, 0.5) 38%, rgba(0, 0, 0, 0) 60%);
    mask-image: linear-gradient(to top,
      rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.92) 20%,
      rgba(0, 0, 0, 0.5) 38%, rgba(0, 0, 0, 0) 60%);
    will-change: transform, opacity;
  }

  .lh-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Deep ember tail -> molten core -> white-hot tip at the burn edge. The
     vertical banding gives the displacement filter something to tear into, so
     it breaks up into separate tongues instead of one wobbling sheet. */
  .lh-flame {
    position: absolute;
    inset: 0;
    /* Alpha peaks well below 1: fire should glow OVER the ground, not paint an
       opaque panel across it. */
    background: linear-gradient(96deg,
      rgba(150, 22, 0, 0) 0%,
      rgba(196, 40, 2, 0.10) 32%,
      rgba(248, 78, 10, 0.24) 56%,
      rgba(255, 118, 26, 0.42) 74%,
      rgba(255, 158, 52, 0.58) 87%,
      rgba(255, 200, 110, 0.70) 95%,
      rgba(255, 232, 176, 0.78) 100%);
    /* No repeating tongue banding here any more: regular stripes read as a
       picket fence and the displacement filter never fully broke them up. The
       fire now comes from .lh-hot (the real lava flaring); this layer is just
       the light it throws, and the turbulence gives that light a ragged edge. */
    animation: lhFlicker 360ms linear infinite;
    will-change: opacity;
  }

  /* The displacement filter is the expensive part; only run it where there's
     room for it. Small screens keep the plain gradient flame. */
  @media (min-width: 721px) {
    .lh-flame { filter: url('#lhFireFx'); }
  }

  @keyframes lhFlicker {
    0%   { opacity: 0.88; }
    17%  { opacity: 1; }
    34%  { opacity: 0.79; }
    52%  { opacity: 0.97; }
    69%  { opacity: 0.83; }
    86%  { opacity: 1; }
    100% { opacity: 0.9; }
  }

  .lh-embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lh-ember {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(circle,
      rgba(255, 240, 205, 0.95) 0%,
      rgba(255, 168, 72, 0.7) 40%,
      rgba(255, 90, 26, 0) 70%);
    will-change: transform, opacity;
  }

  /* `--d` is a fraction of the sweep; the script sets --burn to the sweep
     duration so each ember lights exactly as the front reaches its x. */
  .lh.is-burning .lh-ember {
    animation: lhEmber calc(var(--burn) * 0.9) ease-out calc(var(--burn) * var(--d)) forwards;
  }

  @keyframes lhEmber {
    0%   { opacity: 0; transform: translate3d(0, 0, 0) scale(0.5); }
    12%  { opacity: 1; }
    60%  { opacity: 0.85; }
    100% { opacity: 0; transform: translate3d(var(--dx), var(--dy), 0) scale(1.15); }
  }

  .lh-heat {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40vh;
    opacity: 0;
    pointer-events: none;
    /* Deliberately faint — at higher alpha this reads as an orange wash over the
       bottom third rather than heat coming off the ground. */
    background: linear-gradient(to top,
      rgba(255, 92, 26, 0.16) 0%,
      rgba(255, 74, 16, 0.07) 34%,
      rgba(255, 60, 10, 0.02) 62%,
      rgba(255, 60, 10, 0) 85%);
    will-change: opacity;
  }

  /* ---- type --------------------------------------------------------------
     Nothing here clips: the mark's glow and the type's shadows extend past
     their boxes, and `overflow: hidden` would render them as a lit rectangle. */
  .lh-type {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.4vw, 2rem);
    padding-inline: 4vw;
    will-change: transform, opacity;
  }

  /* Largest element in the composition, centred on screen. The three glyphs
     slide in one after another like the DSC letters do. The travel (46 user
     units ~= 21px on screen) is kept shorter than the 90-unit gap between
     glyphs so none of them passes through a neighbour's resting place, and the
     stagger is tight — that fragmented in-between state is what read as
     "disoriented" when it lingered. */
  .lh-mark {
    display: block;
    width: clamp(140px, 19vw, 310px);
    height: auto;
    overflow: visible;
    filter:
      drop-shadow(0 0 8px rgba(190, 190, 190, 0.5))
      drop-shadow(0 0 38px rgba(190, 190, 190, 0.32))
      drop-shadow(0 10px 54px rgba(255, 90, 31, 0.2));
  }

  .lh-mark path {
    opacity: 0;
  }

  /* DSC and the full lockup occupy the same cell so they crossfade in place */
  .lh-stack {
    display: grid;
    place-items: center;
  }

  .lh-dsc,
  .lh-full {
    grid-area: 1 / 1;
  }

  /* Second largest. `gap` (not letter-spacing) so the two gaps are exactly
     equal — letter-spacing also adds a trailing space that breaks centring. */
  .lh-dsc {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: clamp(0.7rem, 2.3vw, 1.8rem);
    font-family: 'Inter', 'Inter Fallback', sans-serif;
    font-weight: 800;
    font-size: clamp(2.4rem, 6.6vw, 5rem);
    line-height: 1;
    color: #f7f7f5;
    text-shadow: 0 0 60px rgba(0, 0, 0, 0.9), 0 4px 30px rgba(255, 96, 32, 0.28);
  }

  .lh-dsc-l {
    display: inline-block;
    opacity: 0;
  }

  .lh-full {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.45rem, 1.1vw, 0.8rem);
  }

  /* keeps a word from breaking mid-way once it's split into per-letter spans */
  .lh-nb {
    display: inline-block;
    white-space: nowrap;
  }

  .lh-l {
    display: inline-block;
    opacity: 0;
    /* White-to-grey tint, same direction as the mark's own gradient. Applied
       per letter (not once on .lh-word) because each letter is a separate
       inline-block for the stagger animation — a single background-clip:text
       on the parent wouldn't paint through child boxes. Since every letter is
       the same height, an identical vertical gradient on each one reads as one
       continuous gradient across the whole word, not repeating bands. */
    background: linear-gradient(180deg, #f4f4f4 0%, #8c8c8c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Third: smaller than DSC. Evenly tracked, and text-indent cancels half the
     trailing letter-space so the line stays optically centred. */
  .lh-word {
    margin: 0;
    white-space: nowrap;
    font-family: 'Inter', 'Inter Fallback', sans-serif;
    font-weight: 700;
    font-size: clamp(0.98rem, 2.05vw, 1.58rem);
    line-height: 1.1;
    letter-spacing: 0.17em;
    /* HALF the letter-spacing: the trailing space after the last glyph pushes
       the ink half a letter-space left of the box centre, so the correction is
       L/2, not L. Using the full value overshoots and de-centres the line. */
    text-indent: 0.085em;
    /* fill colour now comes from the gradient on .lh-l (see above) */
    text-shadow: 0 0 40px rgba(0, 0, 0, 0.92), 0 2px 16px rgba(0, 0, 0, 0.7);
  }

  /* Smallest, sits under the wordmark */
  .lh-sub {
    margin: 0;
    white-space: nowrap;
    font-family: 'Inter', 'Inter Fallback', sans-serif;
    font-weight: 500;
    font-size: clamp(0.58rem, 1.02vw, 0.8rem);
    line-height: 1.1;
    letter-spacing: 0.34em;
    text-indent: 0.17em; /* half of letter-spacing — see .lh-word */
    color: #2fd8d5;
    text-shadow: 0 0 26px rgba(0, 0, 0, 0.9);
  }

  @media (max-width: 720px) {
    .lh-mark { width: clamp(150px, 42vw, 260px); }
    .lh-dsc { font-size: clamp(2.2rem, 13vw, 3.6rem); }
    .lh-word { font-size: clamp(0.8rem, 3.7vw, 1.2rem); letter-spacing: 0.13em; text-indent: 0.065em; }
    .lh-sub { font-size: clamp(0.52rem, 2.1vw, 0.7rem); letter-spacing: 0.26em; text-indent: 0.13em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lh-mark path { opacity: 1 !important; transform: none !important; }
    .lh-ember { display: none; }
    .lh-flame { filter: none !important; }
    .lh-dsc { opacity: 0 !important; }
    .lh-full { opacity: 1 !important; }
    .lh-l { opacity: 1 !important; transform: none !important; }
    .lh-lit { -webkit-mask-image: none !important; mask-image: none !important; }
    .lh-front,
    .lh-heat { display: none; }
  }
</style>

<script>
  import { createTimeline, stagger, utils } from 'animejs';

  const loader = document.getElementById('intro-loader-cinematic');
  if (loader) {
    const doc = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- own the scroll position -------------------------------------------
    // A reload restores the previous offset underneath our fixed overlay, which
    // would make the ignition reveal the middle of the page.
    const prevRestore = history.scrollRestoration;
    const prevBehavior = doc.style.scrollBehavior;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    doc.style.scrollBehavior = 'auto'; // global.css sets scroll-behavior:smooth
    window.scrollTo(0, 0);
    doc.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // ---- take hold of the real hero ----------------------------------------
    const heroRoot = document.getElementById('home');
    const heroLayer = heroRoot && heroRoot.querySelector('.hero-zoom');
    const heroAnims = heroRoot ? Array.from(heroRoot.querySelectorAll('.hero-anim')) : [];

    document.body.classList.add('ilc-active', 'ilc-running', 'ilc-reveal-hold');
    let pointerSeen = false;
    window.addEventListener('mousemove', () => { pointerSeen = true; }, { once: true, passive: true });

    // WAAPI only touches animation timelines, never DOM attributes, so this is
    // hydration-safe. Under prefers-reduced-motion global.css sets
    // `animation: none`, so getAnimations() is empty and these self-disable.
    const hold = (el) => el && el.getAnimations().forEach((a) => { a.pause(); a.currentTime = 0; });
    hold(heroLayer);
    heroAnims.forEach(hold);

    const lit = loader.querySelector('.lh-lit');
    const hot = loader.querySelector('.lh-hot');

    // ---- intro beats --------------------------------------------------------
    let introDone = reduce;
    let heroReady = false;
    let pageLoaded = document.readyState === 'complete';
    let ignited = false;
    let introTl = null;

    if (!reduce) {
      // The terrain never moves — it sits at the hero's resting frame the whole
      // time and is simply invisible until the fire uncovers it.
      // Start the flame exactly on the burn edge — see the travel comment in
      // ignite() for why the range is -24vw -> 108vw.
      utils.set('.lh-front', { translateX: '-24vw' });

      introTl = createTimeline({
        defaults: { ease: 'outQuint' },
        onComplete: () => { introDone = true; maybeIgnite(); },
      })
        // Beat 1 — the three glyphs slide in sideways, one after another
        .add('.lh-mark path', {
          opacity: [0, 1], translateX: [46, 0], duration: 480, delay: stagger(120),
        }, 80)
        // Beat 2 — D, S, C arrive the same way beneath it
        .add('.lh-dsc-l', {
          opacity: [0, 1], translateX: [30, 0], duration: 440, delay: stagger(100),
        }, 620);
    }

    // ---- readiness gate -----------------------------------------------------
    const img = new Image();
    img.src = '/creative-ai/hero_bg1.webp'; // preloaded in BaseLayout -> cache hit
    const markReady = () => { heroReady = true; maybeIgnite(); };
    if (img.complete) markReady();
    else if (img.decode) img.decode().then(markReady, markReady);
    else { img.onload = markReady; img.onerror = markReady; }

    if (!pageLoaded) {
      window.addEventListener('load', () => { pageLoaded = true; maybeIgnite(); });
    }

    function maybeIgnite(force) {
      if (ignited) return;
      if (!force && !(introDone && heroReady && pageLoaded)) return;
      ignited = true;
      if (introTl) introTl.pause(); // stop the intro fighting the exit on the forced path
      ignite();
    }

    setTimeout(() => maybeIgnite(true), 5000);
    if (document.visibilityState === 'hidden') maybeIgnite(true);

    // ---- handoff ------------------------------------------------------------
    function finish() {
      loader.remove();
      doc.style.overflow = '';
      document.body.style.overflow = '';
      doc.style.scrollBehavior = prevBehavior;
      if ('scrollRestoration' in history) history.scrollRestoration = prevRestore || 'auto';
      document.body.classList.remove('ilc-running');

      // Lock every held hero animation into its end state, whichever path we took.
      [heroLayer, ...heroAnims].forEach((el) => {
        if (el) el.getAnimations().forEach((a) => { try { a.finish(); } catch (e) {} });
      });

      // Hand the cursor spotlight back once there's a real mask to show. On touch
      // no mousemove ever fires, so the ridge simply stays — which is what the
      // spotlight interaction implies anyway.
      const release = () => {
        document.body.classList.remove('ilc-reveal-hold');
        setTimeout(() => document.body.classList.remove('ilc-active'), 600);
      };
      if (pointerSeen) requestAnimationFrame(release);
      else window.addEventListener('mousemove', () => setTimeout(release, 32), { once: true, passive: true });
    }

    function ignite() {
      if (reduce) {
        document.body.classList.remove('ilc-running');
        createTimeline({ onComplete: finish })
          .add('.lh-type', { opacity: 0, duration: 180 }, 0)
          .add(loader, { opacity: 0, duration: 240, ease: 'linear' }, 120);
        return;
      }

      // Release the hero's OWN Ken Burns. Its 1s runtime overruns this handoff,
      // so the camera is still moving after the loader is gone.
      if (heroLayer) heroLayer.getAnimations().forEach((a) => a.play());

      // Kick the ember animations; --burn matches the sweep so each spark
      // lights as the front reaches its x.
      const BURN = 1250;
      loader.style.setProperty('--burn', BURN + 'ms');
      loader.classList.add('is-burning');

      // The fire spreads. The mask string is rebuilt each frame from a plain
      // object, so the value is interpolated in JS — no reliance on CSS
      // custom-property animation. A gradient mask (rather than a clip-path)
      // gives the fire a soft, graded leading edge instead of a hard vertical
      // cut, and the tilt matches the ridge running up to the right.
      const SOFT = 16; // width of the burn edge, in % of the frame
      // v is the leading edge and `a` the trailing edge of the burn band. v
      // starts at -SOFT so the band begins fully OFF-frame and slides in — and
      // it must never be clamped with Math.max(0, …), because a stop list that
      // decreases (…6%, 11%, 0%) gets clamped by CSS to the previous stop and
      // leaves a fully-revealed strip glued to the left edge. Keeping a < v
      // unconditionally is what makes the start clean.
      const sweep = { v: -SOFT };
      // Three flame tongues ride just ahead of the main front and wobble, so the
      // burn line is lobed and alive instead of ruler-straight. Mask layers
      // composite additively, so each tongue pushes the revealed area further
      // right at its own height.
      const tongue = (cx, cy, rx, ry) =>
        `radial-gradient(${rx}% ${ry}% at ${cx}% ${cy}%,`
        + ` rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.9) 32%, rgba(0,0,0,0) 74%)`;

      const paintSweep = () => {
        if (!lit) return;
        const v = sweep.v;
        const a = v - SOFT;
        const t = performance.now() / 1000;
        // The first stop's colour extends left of it and the last extends right,
        // so this covers the whole element with only four stops.
        const base = `linear-gradient(96deg,`
          + ` rgba(0,0,0,1) ${a}%,`
          + ` rgba(0,0,0,0.78) ${a + SOFT * 0.38}%,`
          + ` rgba(0,0,0,0.34) ${a + SOFT * 0.72}%,`
          + ` rgba(0,0,0,0) ${v}%)`;
        // Kept small and centred near the edge (a + ~0.6*SOFT). Larger tongues
        // reach far past v and light up detached islands of ground ahead of the
        // fire; these only perturb the edge by a couple of percent.
        const g = [
          tongue(a + 10 + Math.sin(t * 6.1) * 2.2, 22, 9, 24),
          tongue(a + 12 + Math.sin(t * 4.7 + 1.9) * 2.6, 57, 7, 20),
          tongue(a + 9 + Math.sin(t * 7.3 + 3.4) * 2.0, 85, 9, 26),
          base,
        ].join(', ');
        lit.style.webkitMaskImage = g;
        lit.style.maskImage = g;

        // The blazing band: a narrow window just behind the burn edge, so the
        // lava flares as the fire arrives and cools off behind it.
        if (hot) {
          const h = `linear-gradient(96deg,`
            + ` rgba(0,0,0,0) ${v - SOFT * 2.1}%,`
            + ` rgba(0,0,0,0.55) ${v - SOFT * 1.25}%,`
            + ` rgba(0,0,0,1) ${v - SOFT * 0.5}%,`
            + ` rgba(0,0,0,0) ${v}%)`;
          hot.style.webkitMaskImage = h;
          hot.style.maskImage = h;
        }
      };
      paintSweep();

      // All exit tweens are to-only so anime reads the live value; that keeps the
      // forced/safety path from snapping.
      createTimeline({ defaults: { ease: 'outQuint' }, onComplete: finish })
        // v overshoots to 100+SOFT so the trailing soft edge clears the right
        // side — at v=100 the last 16% would still be partly masked, and the
        // terrain must end up FULLY revealed to match the hero exactly.
        .add(sweep, {
          v: 100 + SOFT,
          duration: 1250,
          ease: 'inOutQuad',
          onUpdate: paintSweep,
        }, 0)
        // The flame's bright end is its own right edge, which sits at x=0 when
        // translateX is 0 (left:-26vw + width:26vw). The mask's soft edge
        // midpoint is v - SOFT/2, and v runs -SOFT -> 100+SOFT, so that midpoint
        // runs -24% -> 108%. The flame must travel that SAME range: matching it
        // to 0->100vw instead lets the mask outrun the fire and the terrain gets
        // revealed ahead of the visible flame.
        .add('.lh-front', { opacity: 1, duration: 200, ease: 'outQuad' }, 0)
        .add('.lh-front', { translateX: '108vw', duration: 1250, ease: 'inOutQuad' }, 0)
        // fully out by the time the sweep lands, so it leaves no warm residue
        .add('.lh-front', { opacity: 0, duration: 340, ease: 'inQuad' }, 900)
        // heat rises as the ground ignites, then dies back before the handoff
        .add('.lh-heat', { opacity: 1, duration: 760, ease: 'outQuad' }, 220)
        .add('.lh-heat', { opacity: 0, duration: 640, ease: 'inOutQuad' }, 1400)
        // …and AS the fire travels, DSC hands over to the full lockup in place
        // DSC holds settled and centred for a real beat before handing over —
        // starting the crossfade early meant it was still sliding in from the
        // right for almost its whole time on screen, which read as off-centre.
        .add('.lh-dsc', { opacity: 0, scale: 1.05, duration: 440, ease: 'inOutQuad' }, 380)
        // both lines arrive sideways too, one letter after the other
        .add('.lh-word .lh-l', {
          opacity: [0, 1], translateX: [22, 0], duration: 460, delay: stagger(18),
        }, 560)
        .add('.lh-sub .lh-l', {
          opacity: [0, 1], translateX: [16, 0], duration: 420, delay: stagger(16),
        }, 720)
        // …the frame HOLDS: mark and lockup standing over a fully lit ridge.
        .add('.lh-type', { opacity: 0, translateY: '-2.2vh', duration: 520 }, 1720)
        // hand over: the lit ridge already matches, so only the loader fades
        .call(() => {
          heroAnims.forEach((el) => el.getAnimations().forEach((a) => a.play()));
          document.body.classList.remove('ilc-running'); // chrome fades in via CSS
        }, 1900)
        .add(loader, { opacity: 0, duration: 470, ease: 'outQuint' }, 1920);
    }

    maybeIgnite();
  }
</script>
