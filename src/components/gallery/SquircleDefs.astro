---
/**
 * SquircleDefs
 * Developer Students Club • SRM IST Ramapuram
 *
 * Emits the shared superellipse clip path once per document. Any element
 * can then reference it with `clip-path: url(#squircle-clip)`.
 *
 * The path solves |2x-1|^n + |2y-1|^n = 1 at n = 4.5 — a true superellipse,
 * not a rounded rectangle. Authored in `objectBoundingBox` units (0..1) so a
 * single definition stretches to any element size without per-breakpoint
 * variants.
 *
 * Static markup with no interactivity, so it stays an .astro component and
 * ships no client JavaScript.
 */
---

<svg class="squircle-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="squircle-clip" clipPathUnits="objectBoundingBox">
      <path d="M1.0000,0.5000L0.9989,0.6781L0.9957,0.7418L0.9903,0.7886L0.9827,0.8263L0.9728,0.8579L0.9606,0.8851L0.9459,0.9084L0.9286,0.9286L0.9084,0.9459L0.8851,0.9606L0.8579,0.9728L0.8263,0.9827L0.7886,0.9903L0.7418,0.9957L0.6781,0.9989L0.5000,1.0000L0.3219,0.9989L0.2582,0.9957L0.2114,0.9903L0.1737,0.9827L0.1421,0.9728L0.1149,0.9606L0.0916,0.9459L0.0714,0.9286L0.0541,0.9084L0.0394,0.8851L0.0272,0.8579L0.0173,0.8263L0.0097,0.7886L0.0043,0.7418L0.0011,0.6781L0.0000,0.5000L0.0011,0.3219L0.0043,0.2582L0.0097,0.2114L0.0173,0.1737L0.0272,0.1421L0.0394,0.1149L0.0541,0.0916L0.0714,0.0714L0.0916,0.0541L0.1149,0.0394L0.1421,0.0272L0.1737,0.0173L0.2114,0.0097L0.2582,0.0043L0.3219,0.0011L0.5000,0.0000L0.6781,0.0011L0.7418,0.0043L0.7886,0.0097L0.8263,0.0173L0.8579,0.0272L0.8851,0.0394L0.9084,0.0541L0.9286,0.0714L0.9459,0.0916L0.9606,0.1149L0.9728,0.1421L0.9827,0.1737L0.9903,0.2114L0.9957,0.2582L0.9989,0.3219Z" />
