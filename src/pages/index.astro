---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import IntroLoader from '../components/intro-loader/IntroLoader.astro';

import cmeGroupLogo from '../../assets/Alumnus company/cme group.png';
import lloydsLogo from '../../assets/Alumnus company/lloyds.png';
import kpmgLogo from '../../assets/Alumnus company/kpmg.png';
import microsoftLogo from '../../assets/Alumnus company/microsoft.png';
import googleLogo from '../../assets/Alumnus company/google.png';
import amazonLogo from '../../assets/Alumnus company/amazon.png';
import infosysLogo from '../../assets/Alumnus company/infosys.webp';
import githubLogo from '../../assets/Alumnus company/github.png';
import tcsLogo from '../../assets/Alumnus company/tcs.webp';
import valueLabsLogo from '../../assets/Alumnus company/value labs.png';
import deccanLogo from '../../assets/Alumnus company/deccan.png';
import jpMorganLogo from '../../assets/Alumnus company/jp morgan.png';
---

<BaseLayout>
  <!-- Cinematic Intro Loader -->
  <IntroLoader />

  <!-- Hero Component (React Island) -->
  <Hero client:load />

  <!-- ========== CREATIVE AI SECTION ========== -->
  <section class="creative-ai-section">
    <div class="ca-grid">
      <!-- Row 1 -->
      <div class="ca-cell ca-white-block ca-span-2">
        <h2 class="ca-heading">Fostering developer<br>innovation</h2>
        <p class="ca-text">Developer Students Club, SRM IST Ramapuram provides<br>a collaborative space for students to learn, build, and grow<br>together, bridging the gap between theory and practice.</p>
      </div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>

      <!-- Row 2 -->
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-white-block ca-center-1">
        <h3 class="ca-subheading">Hands-on learning &<br>workshops</h3>
        <p class="ca-text">Master modern frameworks, tools, and<br>platforms through peer-led study groups and<br>interactive tech workshops.</p>
      </div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>

      <!-- Row 3 -->
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-white-block ca-right-1">
        <h3 class="ca-subheading">Real-world project<br>development</h3>
        <p class="ca-text">Apply theoretical concepts to solve real<br>local problems, collaborate in teams, and<br>build impactful open-source projects.</p>
      </div>

      <!-- Row 4 -->
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-empty"></div>
      <div class="ca-cell ca-white-block ca-center-2">
        <h3 class="ca-subheading">Global network &<br>mentorship</h3>
        <p class="ca-text">Connect with developers worldwide, learn<br>from industry experts, and prepare for a<br>career in the tech industry.</p>
      </div>
      <div class="ca-cell ca-empty"></div>
    </div>
  </section>

  <!-- ========== PROJECT SHOWCASE SECTION ========== -->
  <section class="showcase-section">
    <div class="showcase-sticky-container">
      <div class="showcase-track">
        
        <!-- Card 1 -->
        <div class="showcase-card">
          <div class="showcase-card-header">
            <span class="header-title">NEBULLA</span>
            <span class="header-page">PAGE 17 / 35</span>
          </div>
          <div class="showcase-card-content">
            <div class="showcase-bg-shapes">
              <svg class="shape-circle" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="48" stroke="#111" stroke-width="0.5"/>
              </svg>
              <svg class="shape-star-pink" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M50 0 C50 40 60 50 100 50 C60 50 50 60 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#ff4dcd"/>
              </svg>
            </div>
            
            <h3 class="showcase-title">~ Vlogger</h3>
            
            <div class="showcase-center-image">
              <img src="/showcase/showcase_1.png" alt="Vlogger" />
            </div>

            <div class="showcase-bottom-info">
              <div class="showcase-highlight">
                <h4>Highlight</h4>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce faucibus, nulla ac ultricies semper, nibh dui molstie est, non lacinia turpis augue.</p>
              </div>
              <div class="showcase-right-label">
                <span class="vertical-text">Nebulla <span class="arrow">⟶</span> Presentation</span>
                <svg class="shape-star-black" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <path d="M50 0 C50 40 60 50 100 50 C60 50 50 60 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#111"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="showcase-card">
          <div class="showcase-card-header">
            <span class="header-title">NEBULLA</span>
            <span class="header-page">PAGE 18 / 35</span>
          </div>
          <div class="showcase-card-content">
            <div class="showcase-bg-shapes">
              <svg class="shape-circle" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="48" stroke="#111" stroke-width="0.5"/>
              </svg>
              <svg class="shape-star-pink" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M50 0 C50 40 60 50 100 50 C60 50 50 100 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#ff4dcd"/>
              </svg>
            </div>
            
            <h3 class="showcase-title">~ Developer</h3>
            
            <div class="showcase-center-image">
              <img src="/showcase/showcase_2.png" alt="Developer" />
            </div>

            <div class="showcase-bottom-info">
              <div class="showcase-highlight">
                <h4>Highlight</h4>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce faucibus, nulla ac ultricies semper, nibh dui molstie est, non lacinia turpis augue.</p>
              </div>
              <div class="showcase-right-label">
                <span class="vertical-text">Nebulla <span class="arrow">⟶</span> Presentation</span>
                <svg class="shape-star-black" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <path d="M50 0 C50 40 60 50 100 50 C60 50 50 60 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#111"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="showcase-card">
          <div class="showcase-card-header">
            <span class="header-title">NEBULLA</span>
            <span class="header-page">PAGE 19 / 35</span>
          </div>
          <div class="showcase-card-content">
            <div class="showcase-bg-shapes">
              <svg class="shape-circle" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="48" stroke="#111" stroke-width="0.5"/>
              </svg>
              <svg class="shape-star-pink" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M50 0 C50 40 60 50 100 50 C60 50 50 60 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#ff4dcd"/>
              </svg>
            </div>
            
            <h3 class="showcase-title">~ Designer</h3>
            
            <div class="showcase-center-image">
              <img src="/showcase/showcase_3.png" alt="Designer" />
            </div>

            <div class="showcase-bottom-info">
              <div class="showcase-highlight">
                <h4>Highlight</h4>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce faucibus, nulla ac ultricies semper, nibh dui molstie est, non lacinia turpis augue.</p>
              </div>
              <div class="showcase-right-label">
                <span class="vertical-text">Nebulla <span class="arrow">⟶</span> Presentation</span>
                <svg class="shape-star-black" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <path d="M50 0 C50 40 60 50 100 50 C60 50 50 60 50 100 C50 60 40 50 0 50 C40 50 50 40 50 0 Z" fill="#111"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== PARTNERSHIP SECTION ========== -->
  <section class="partnership-section">
    <div class="partnership-content reveal">
      <h2 class="partnership-heading">Backed by Google Developers</h2>
      <p class="partnership-subheading">We are a university-based community group for students. Join our chapter to learn, connect, and build tech solutions for local businesses and your community.</p>
      <a href="#" class="btn-partnership">Join Our Chapter</a>
    </div>
  </section>

  <!-- ========== ALUMNI MARQUEE SECTION ========== -->
  <section class="alumni-marquee-section">
    <h2 class="alumni-heading">Our Alumni Work At</h2>
    <div class="marquee-container">
      <div class="marquee-track">
        <!-- Original set of logos -->
        <div class="alumni-card"><img src={cmeGroupLogo.src} alt="CME Group" style="width: 130px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={lloydsLogo.src} alt="Lloyds London" style="width: 120px; height: 85px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={kpmgLogo.src} alt="KPMG" style="width: 70px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={githubLogo.src} alt="GitHub" style="width: 65px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={microsoftLogo.src} alt="Microsoft" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={googleLogo.src} alt="Google" style="width: 90px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={amazonLogo.src} alt="Amazon" style="width: 90px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={infosysLogo.src} alt="Infosys" style="width: 150px; height: 75px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={tcsLogo.src} alt="TCS" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={valueLabsLogo.src} alt="Value Labs" style="width: 120px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={deccanLogo.src} alt="Deccan" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={jpMorganLogo.src} alt="JP Morgan" style="width: 120px; height: 65px; object-fit: contain; transform: scale(1.4);" /></div>
        
        <!-- Duplicated set of logos for seamless looping -->
        <div class="alumni-card"><img src={cmeGroupLogo.src} alt="CME Group" style="width: 130px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={lloydsLogo.src} alt="Lloyds London" style="width: 120px; height: 85px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={kpmgLogo.src} alt="KPMG" style="width: 70px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={githubLogo.src} alt="GitHub" style="width: 65px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={microsoftLogo.src} alt="Microsoft" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={googleLogo.src} alt="Google" style="width: 90px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={amazonLogo.src} alt="Amazon" style="width: 90px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={infosysLogo.src} alt="Infosys" style="width: 150px; height: 75px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={tcsLogo.src} alt="TCS" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={valueLabsLogo.src} alt="Value Labs" style="width: 120px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={deccanLogo.src} alt="Deccan" style="width: 110px; height: 65px; object-fit: contain;" /></div>
        <div class="alumni-card"><img src={jpMorganLogo.src} alt="JP Morgan" style="width: 120px; height: 65px; object-fit: contain; transform: scale(1.4);" /></div>
      </div>
    </div>
  </section>

  <!-- ========== TESTIMONIALS SECTION ========== -->
  <section class="testimonials-section">
    <div class="testimonials-container">
      <h2 class="testimonials-heading">Wall of Testimonials</h2>
      
      <!-- Testimonial 1 -->
      <div class="testimonial-card">
        <div class="testimonial-content-wrapper top-card">
          <div class="testimonial-text-area">
            <p class="testimonial-quote">
              I have waited my entire life for a design tool like this - nearly my entire life. With SlothUI, less is truly more. Period.
            </p>
            <div class="testimonial-author">
              <span class="author-name">— Vermillion D. White</span>
              <span class="author-title">CEO, planetX.ai</span>
            </div>
          </div>
          <div class="testimonial-image-area">
            <img src="/testimonials/testimonial_1.png" alt="Vermillion D. White" class="author-portrait portrait-right" />
          </div>
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="testimonial-card">
        <div class="testimonial-content-wrapper bottom-card">
          <div class="testimonial-image-area">
            <img src="/testimonials/testimonial_2.png" alt="Vermillion D. White" class="author-portrait portrait-left" />
          </div>
          <div class="testimonial-text-area">
            <p class="testimonial-quote">
              I have waited my entire life for a design tool like this - nearly my entire life. With SlothUI, less is truly more. Period.
            </p>
            <div class="testimonial-author-row">
              <div class="testimonial-author">
                <span class="author-name">— Vermillion D. White</span>
                <span class="author-title">CEO, planetX.ai</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========== CONTRA LABS FOOTER ========== -->
  <footer class="contra-footer" id="contact">
    <div class="contra-content">
      <h2 class="contra-logo contra-footer-logo">Developer Students Club</h2>
      <p class="contra-subtitle">SRM IST, Ramapuram</p>
      
      <div class="contra-socials">
        <a href="#" aria-label="X">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>

        <a href="#" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
        <a href="#" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>

      <div class="contra-links">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="/domains">Domains</a>
        <a href="/gallery">Gallery</a>
        <a href="/team">Team</a>
        <a href="/contact">Contact</a>
      </div>
    </div>

    <video data-src="https://framerusercontent.com/assets/hmg5dFU33RwVgzS4V0wrSxuKJ3E.mp4" class="contra-art" loop muted playsinline preload="none"></video>
  </footer>

  <!-- Main Behavior Script -->
  <script src="../scripts/main.js"></script>

  <!-- GSAP ScrollTrigger for Showcase -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('DOMContentLoaded', () => {
      const showcaseTrack = document.querySelector('.showcase-track');
      if (showcaseTrack) {
        // We calculate horizontal scroll length
        const getScrollAmount = () => -(showcaseTrack.scrollWidth - window.innerWidth + 40); // 40px padding

        const tween = gsap.to(showcaseTrack, {
          x: getScrollAmount,
          ease: "none"
        });

        ScrollTrigger.create({
          trigger: ".showcase-section",
          start: "top top",
          end: () => `+=${showcaseTrack.scrollWidth - window.innerWidth}`,
          pin: true,
          animation: tween,
          scrub: 1,
          invalidateOnRefresh: true,
        });
      }
    });
  </script>
</BaseLayout>
